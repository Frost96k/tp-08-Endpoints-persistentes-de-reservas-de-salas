<article class="detalle">
  <p class="eyebrow"><%= reserva.sala %> · <%= reserva.turno %></p>
  <h1>Reserva de <%= reserva.estudiante %></h1>
  <dl>
    <dt>Número</dt><dd><%= reserva.id %></dd>
    <dt>Estudiante</dt><dd><%= reserva.estudiante %></dd>
    <dt>Email</dt><dd><%= reserva.email %></dd>
    <dt>Sala</dt><dd><%= reserva.sala %></dd>
    <dt>Fecha</dt><dd><%= reserva.fecha %></dd>
    <dt>Turno</dt><dd><%= reserva.turno %></dd>
    <dt>Personas</dt><dd><%= reserva.personas %></dd>
    <dt>Estado</dt><dd><%= reserva.estado %></dd>
  </dl>
  <a href="/reservas">Volver al listado</a>
</article>
