{
  "name": "tp-08-salas-http-mongodb",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio HTML y API HTTP de reservas persistentes con MongoDB y Mongoose",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "start:local": "node --env-file=.env src/index.js",
    "db:check": "node --env-file=.env scripts/comprobar-conexion.js",
    "db:create": "node --env-file=.env scripts/crear-reserva.js",
    "db:list": "node --env-file=.env scripts/listar-reservas.js",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "lint": "eslint src scripts",
    "check": "npm run format:check && npm run lint"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "mongoose": "^8.11.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.0.0"
  }
}
